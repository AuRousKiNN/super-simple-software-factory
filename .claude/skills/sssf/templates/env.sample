# SSSF environment. Copy to .env at the target repo root.
#
# The default `codex.auth: cli` reuses the operator's existing Codex login and
# needs no key here. Set `codex.auth: api_key` only for an unattended runtime,
# then provide OPENAI_API_KEY without putting it in config, traces, or argv.

OPENAI_API_KEY=

# Optional overrides
# CODEX_PATH=/absolute/path/to/codex  # only a deliberately verified 0.155.1 binary
# ENGINEER_NAME=                      # lane label; defaults to git user.name
